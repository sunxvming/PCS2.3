
(* @NESTEDCOMMENTS := 'Yes' *)
(* @PATH := '' *)
(* @OBJECTFLAGS := '0, 8' *)
(* @SYMFILEFLAGS := '2048' *)
FUNCTION_BLOCK SLD_SHD_Channels
VAR_OUTPUT
	SHD_SIGN_OUT        : BOOL; (*停车信号*)
	SLD_SIGN_OUT        : BOOL; (*降速信号*)
	HORN_OUT            : BOOL; (*报警蜂鸣*)
	SHD_LAMP_OUT        : BOOL; (*停车指示灯*)
	SLD_LAMP_OUT        : BOOL; (*降速指示灯*)
	OMD_SLD_LAMP_OUT    : BOOL; (*可取消降速指示灯*)
	NORMAL_SLD_LAMP_OUT : BOOL; (*正常降速指示灯*)
	OMD_SLD_SIGN_OUT    : BOOL; (*可取消降速信号*)
	NORMAL_SLD_SIGN_OUT : BOOL; (*正常降速信号*)
END_VAR
VAR
	(*停车通道 SHD_CH_1~6*)
	SHD_CH_1 : SLD_SHD_PROCESS; (*缸套冷却水进口压力低停车 PS1101S*)
	SHD_CH_1_ACTIVE : BOOL;
	SHD_CH_2 : SLD_SHD_PROCESS; (*主机滑油进口压力极低停车 PS2002S，无滤波延时，不可超越*)
	SHD_CH_2_ACTIVE : BOOL;
	SHD_CH_3 : SLD_SHD_PROCESS; (*推力轴承滑油温度高停车 TS4521S*)
	SHD_CH_3_ACTIVE : BOOL;
	SHD_CH_4 : SLD_SHD_PROCESS; (*增压器轴承滑油进口压力低停车 PS2611S*)
	SHD_CH_4_ACTIVE : BOOL;
	SHD_CH_5 : SLD_SHD_PROCESS; (*排气阀弹簧空气进口压力低停车 PS4341S*)
	SHD_CH_5_ACTIVE : BOOL;
	SHD_CH_6 : SLD_SHD_PROCESS; (*超速停车，不可超越*)
	SHD_CH_6_ACTIVE : BOOL;
	(*降速通道 SLD_CH_1~15*)
	SLD_CH_1  : SLD_SHD_PROCESS; (*曲拐箱油雾浓度高降速，可取消 OMD  AS2401S*)
	SLD_CH_1_ACTIVE  : BOOL;
	SLD_CH_2  : SLD_SHD_PROCESS; (*AMS综合降速信号 AMSXS9301S*)
	SLD_CH_2_ACTIVE  : BOOL;
	SLD_CH_3  : SLD_SHD_PROCESS; (*AMS主机滑油进口压力低降速*)
	SLD_CH_3_ACTIVE  : BOOL;
	SLD_CH_4  : SLD_SHD_PROCESS; (*AMS增压器滑油进口压力低降速*)
	SLD_CH_4_ACTIVE  : BOOL;
	SLD_CH_5  : SLD_SHD_PROCESS; (*AMS排气阀空气弹簧压力低降速*)
	SLD_CH_5_ACTIVE  : BOOL;
	SLD_CH_6  : SLD_SHD_PROCESS; (*AMS增压器转速高降速*)
	SLD_CH_6_ACTIVE  : BOOL;
	SLD_CH_7  : SLD_SHD_PROCESS; (*AMS缸套冷却水出口温度高降速*)
	SLD_CH_7_ACTIVE  : BOOL;
	SLD_CH_8  : SLD_SHD_PROCESS; (*AMS缸活塞冷却油出口温度高降速*)
	SLD_CH_8_ACTIVE  : BOOL;
	SLD_CH_9  : SLD_SHD_PROCESS; (*AMS推力轴承滑油出口温度高降速*)
	SLD_CH_9_ACTIVE  : BOOL;
	SLD_CH_10 : SLD_SHD_PROCESS; (*AMS增压器滑油出口温度高降速*)
	SLD_CH_10_ACTIVE : BOOL;
	SLD_CH_11 : SLD_SHD_PROCESS; (*AMS缸排气温度高降速*)
	SLD_CH_11_ACTIVE : BOOL;
	SLD_CH_12 : SLD_SHD_PROCESS; (*AMS增压器进口排气温度高降速*)
	SLD_CH_12_ACTIVE : BOOL;
	SLD_CH_13 : SLD_SHD_PROCESS; (*AMS缸扫气箱着火温度高降速*)
	SLD_CH_13_ACTIVE : BOOL;
	SLD_CH_14 : SLD_SHD_PROCESS; (*注油器断流降速*)
	SLD_CH_14_ACTIVE : BOOL;
	SLD_CH_15 : SLD_SHD_PROCESS; (*调速器系统异常降速*)
	SLD_CH_15_ACTIVE : BOOL;
	(*HMI时间计数临时数组，各通道剩余延时*)
	SHD_TIME_TEMP : ARRAY[0..5]  OF REAL;
	SLD_TIME_TEMP : ARRAY[0..14] OF REAL;
	i : INT;
	j : INT;
	x : BYTE := 0;
	y : BYTE := 0;
	a : BYTE := 0;
	b : BYTE := 0;
	TEMP_SHD_MIN : REAL := 2000000;
	TEMP_SLD_MIN : REAL := 2000000;
END_VAR

(* @END_DECLARATION := '0' *)
(*每周期初始化输出*)
SHD_SIGN_OUT        := FALSE;
SLD_SIGN_OUT        := FALSE;
HORN_OUT            := FALSE;
SHD_LAMP_OUT        := FALSE;
SLD_LAMP_OUT        := FALSE;
OMD_SLD_LAMP_OUT    := FALSE;
NORMAL_SLD_LAMP_OUT := FALSE;
OMD_SLD_SIGN_OUT    := FALSE;
NORMAL_SLD_SIGN_OUT := FALSE;
FOR i := 0 TO 5 DO
	SHD_TIME_TEMP[i] := 2000000;
END_FOR
FOR j := 0 TO 14 DO
	SLD_TIME_TEMP[j] := 2000000;
END_FOR

(*===========停车通道 SHD===========*)

(*SHD_CH_1: 缸套冷却水进口压力低停车 PS1101S*)
SHD_CH_1(FAILURE := CYL_COOL_WATER_PRESS_INLET_LOW_SHD_P AND (NOT CYL_COOL_WATER_PRESS_INLET_LOW_SHD_PASS_FAIL),
				T_FILTER := Cyl_cool_Water_PS_1101S_SHD_time_filter,
				T_DELAY  := Cyl_cool_Water_PS_1101S_SHD_time_delay,
				OVERRIDE := SHD_OVERRIDE);
CYL_COOL_WATER_INLET_PRESS_LOW := SHD_CH_1.LED;
SHD_LAMP_OUT := SHD_LAMP_OUT OR SHD_CH_1.LAMP;
SHD_SIGN_OUT := SHD_SIGN_OUT OR SHD_CH_1.SIGN;
HORN_OUT     := HORN_OUT OR SHD_CH_1.HORN;
SHD_CH_1_ACTIVE := SHD_CH_1.FILTER_FAILURE_OUT;
IF SHD_CH_1_ACTIVE THEN SHD_TIME_TEMP[0] := SHD_CH_1.TIME_COUNT; END_IF

(*SHD_CH_2: 主机滑油进口压力极低停车 PS2002S，无滤波延时，不可超越*)
SHD_CH_2(FAILURE := MAIN_BRG_OIL_PRESS_VERY_LOW_SHD_P AND (NOT MAIN_BRG_OIL_PRESS_VERY_LOW_SHD_PASS_FAIL),
				T_FILTER := t#0s,
				T_DELAY  := t#0s,
				OVERRIDE := FALSE);
MAIN_BRG_OIL_PRESS_VERY_LOW := SHD_CH_2.LED;
SHD_LAMP_OUT := SHD_LAMP_OUT OR SHD_CH_2.LAMP;
SHD_SIGN_OUT := SHD_SIGN_OUT OR SHD_CH_2.SIGN;
HORN_OUT     := HORN_OUT OR SHD_CH_2.HORN;
SHD_CH_2_ACTIVE := SHD_CH_2.FILTER_FAILURE_OUT;
IF SHD_CH_2_ACTIVE THEN SHD_TIME_TEMP[1] := SHD_CH_2.TIME_COUNT; END_IF

(*SHD_CH_3: 推力轴承滑油温度高停车 TS4521S*)
SHD_CH_3(FAILURE := Thrust_Bearing_Temp_fore_side_HIGH_SHD_P AND (NOT Thrust_Bearing_Temp_fore_side_HIGH_SHD_PASS_FAIL),
				T_FILTER := Main_brng_temp_TS4521S_SHD_time_filter,
				T_DELAY  := Main_brng_temp_TS4521S_SHD_time_delay,
				OVERRIDE := SHD_OVERRIDE);
MAIN_BRG_OIL_TEMP_HIGH := SHD_CH_3.LED;
SHD_LAMP_OUT := SHD_LAMP_OUT OR SHD_CH_3.LAMP;
SHD_SIGN_OUT := SHD_SIGN_OUT OR SHD_CH_3.SIGN;
HORN_OUT     := HORN_OUT OR SHD_CH_3.HORN;
SHD_CH_3_ACTIVE := SHD_CH_3.FILTER_FAILURE_OUT;
IF SHD_CH_3_ACTIVE THEN SHD_TIME_TEMP[2] := SHD_CH_3.TIME_COUNT; END_IF

(*SHD_CH_4: 增压器轴承滑油进口压力低停车 PS2611S*)
SHD_CH_4(FAILURE := TURBOCHG_1_BRG_OIL_PRESS_LOW_SHD AND (NOT TURBOCHG_1_BRG_OIL_PRESS_LOW_SHD_PASS_FAIL),
				T_FILTER := TC_brng_oil_pres_PS2611S_SHD_time_filter,
				T_DELAY  := TC_brng_oil_pres_PS2611S_SHD_time_delay,
				OVERRIDE := SHD_OVERRIDE);
TURBOCHG_1_BRG_OIL_PRESS_LOW := SHD_CH_4.LED;
SHD_LAMP_OUT := SHD_LAMP_OUT OR SHD_CH_4.LAMP;
SHD_SIGN_OUT := SHD_SIGN_OUT OR SHD_CH_4.SIGN;
HORN_OUT     := HORN_OUT OR SHD_CH_4.HORN;
SHD_CH_4_ACTIVE := SHD_CH_4.FILTER_FAILURE_OUT;
IF SHD_CH_4_ACTIVE THEN SHD_TIME_TEMP[3] := SHD_CH_4.TIME_COUNT; END_IF

(*SHD_CH_5: 排气阀弹簧空气进口压力低停车 PS4341S*)
SHD_CH_5(FAILURE := AIR_SPRING_PRESS_LOW_SHD_P AND (NOT AIR_SPRING_PRESS_LOW_SHD_PASS_FAIL),
				T_FILTER := Air_spring_pres_PS4341S_SHD_time_filter,
				T_DELAY  := Air_spring_pres_PS4341S_SHD_time_delay,
				OVERRIDE := SHD_OVERRIDE);
AIR_SPRING_PRESS_VERY_LOW := SHD_CH_5.LED;
SHD_LAMP_OUT := SHD_LAMP_OUT OR SHD_CH_5.LAMP;
SHD_SIGN_OUT := SHD_SIGN_OUT OR SHD_CH_5.SIGN;
HORN_OUT     := HORN_OUT OR SHD_CH_5.HORN;
SHD_CH_5_ACTIVE := SHD_CH_5.FILTER_FAILURE_OUT;
IF SHD_CH_5_ACTIVE THEN SHD_TIME_TEMP[4] := SHD_CH_5.TIME_COUNT; END_IF

(*SHD_CH_6: 超速停车，不可超越*)
SHD_CH_6(FAILURE := OVERSPEED_NOT_LATCHED,
				T_FILTER := t#0s,
				T_DELAY  := t#0s,
				OVERRIDE := FALSE);
H_BR_ECR_AUT_OVERSPEED := SHD_CH_6.LAMP;
OVERSPEED_BX_7321C     := H_BR_ECR_AUT_OVERSPEED;
SHD_SIGN_OUT := SHD_SIGN_OUT OR SHD_CH_6.SIGN;
HORN_OUT     := HORN_OUT OR SHD_CH_6.HORN;
SHD_CH_6_ACTIVE := SHD_CH_6.FILTER_FAILURE_OUT;
IF SHD_CH_6_ACTIVE THEN SHD_TIME_TEMP[5] := SHD_CH_6.TIME_COUNT; END_IF

(*===========降速通道 SLD===========*)

(*SLD_CH_1: 曲拐箱油雾浓度高降速，可取消 OMD  AS2401S*)
SLD_CH_1(FAILURE := OILMIST_CONCEN_IN_CRANKCASE_HIGH_SLD_P AND (NOT OILMIST_CONCEN_IN_CRANKCASE_HIGH_SLD_PASS_FAIL),
				T_FILTER := Oilmist_AS2401S_SHD_time_filter,
				T_DELAY  := Oilmist_AS2401S_SHD_time_delay,
				OVERRIDE := OMD_SLD_OVERRIDE);
OIL_CONCENTRATION_IN_CRANKCASE_HIGH := SLD_CH_1.LED;
SLD_LAMP_OUT     := SLD_LAMP_OUT OR SLD_CH_1.LAMP;
SLD_SIGN_OUT     := SLD_SIGN_OUT OR SLD_CH_1.SIGN;
HORN_OUT         := HORN_OUT OR SLD_CH_1.HORN;
OMD_SLD_LAMP_OUT := OMD_SLD_LAMP_OUT OR SLD_CH_1.LAMP;
OMD_SLD_SIGN_OUT := OMD_SLD_SIGN_OUT OR SLD_CH_1.SIGN;
SLD_CH_1_ACTIVE := SLD_CH_1.FILTER_FAILURE_OUT;
IF SLD_CH_1_ACTIVE THEN SLD_TIME_TEMP[0] := SLD_CH_1.TIME_COUNT; END_IF

(*SLD_CH_2: AMS综合降速信号 AMSXS9301S，轴带发电机接合时使用更长延时*)
IF SHAFT_GENERATOR_ENGAGED_P = FALSE THEN
	SLD_CH_2(FAILURE := SLD_SIGN_FROM_ALARM_SYSTEM AND (NOT SLD_SIGN_FROM_ALARM_SYSTEM_PASS_FAIL),
					T_FILTER := Slowdown_from_AMS_SHD_time_filter,
					T_DELAY  := Slowdown_from_AMS_SHD_time_delay,
					OVERRIDE := SLD_OVERRIDE);
ELSE
	SLD_CH_2(FAILURE := SLD_SIGN_FROM_ALARM_SYSTEM AND (NOT SLD_SIGN_FROM_ALARM_SYSTEM_PASS_FAIL),
					T_FILTER := Slowdown_from_AMS_SHD_time_filter,
					T_DELAY  := AMS_SLD_DELAY_WITH_GENERATOR_ENGAGED,
					OVERRIDE := SLD_OVERRIDE);
END_IF
SLD_MULTIPLE_SOURCE  := SLD_CH_2.LED;
SLD_LAMP_OUT         := SLD_LAMP_OUT OR SLD_CH_2.LAMP;
SLD_SIGN_OUT         := SLD_SIGN_OUT OR SLD_CH_2.SIGN;
HORN_OUT             := HORN_OUT OR SLD_CH_2.HORN;
NORMAL_SLD_LAMP_OUT  := NORMAL_SLD_LAMP_OUT OR SLD_CH_2.LAMP;
NORMAL_SLD_SIGN_OUT  := NORMAL_SLD_SIGN_OUT OR SLD_CH_2.SIGN;
SLD_CH_2_ACTIVE := SLD_CH_2.FILTER_FAILURE_OUT;
IF SLD_CH_2_ACTIVE THEN SLD_TIME_TEMP[1] := SLD_CH_2.TIME_COUNT; END_IF

(*SLD_CH_3: AMS主机滑油进口压力低降速*)
SLD_CH_3(FAILURE := AMS_MAIN_BRG_OIL_PRESS_LOW_SLD_P AND (NOT AMS_MAIN_BRG_OIL_PRESS_LOW_SLD_PASS_FAIL),
				T_FILTER := Slowdown_from_AMS_SHD_time_filter,
				T_DELAY  := Slowdown_from_AMS_SHD_time_delay,
				OVERRIDE := SLD_OVERRIDE);
AMS_MAIN_BRG_OIL_PRESS_LOW := SLD_CH_3.LED;
SLD_LAMP_OUT        := SLD_LAMP_OUT OR SLD_CH_3.LAMP;
SLD_SIGN_OUT        := SLD_SIGN_OUT OR SLD_CH_3.SIGN;
HORN_OUT            := HORN_OUT OR SLD_CH_3.HORN;
NORMAL_SLD_LAMP_OUT := NORMAL_SLD_LAMP_OUT OR SLD_CH_3.LAMP;
NORMAL_SLD_SIGN_OUT := NORMAL_SLD_SIGN_OUT OR SLD_CH_3.SIGN;
SLD_CH_3_ACTIVE := SLD_CH_3.FILTER_FAILURE_OUT;
IF SLD_CH_3_ACTIVE THEN SLD_TIME_TEMP[2] := SLD_CH_3.TIME_COUNT; END_IF

(*SLD_CH_4: AMS增压器滑油进口压力低降速*)
SLD_CH_4(FAILURE := AMS_TURBOCHG_BRG_OIL_PRESS_LOW_SLD_P AND (NOT AMS_TURBOCHG_BRG_OIL_PRESS_LOW_SLD_PASS_FAIL),
				T_FILTER := Slowdown_from_AMS_SHD_time_filter,
				T_DELAY  := Slowdown_from_AMS_SHD_time_delay,
				OVERRIDE := SLD_OVERRIDE);
AMS_TURBOCHG_BRG_OIL_PRESS_LOW := SLD_CH_4.LED;
SLD_LAMP_OUT        := SLD_LAMP_OUT OR SLD_CH_4.LAMP;
SLD_SIGN_OUT        := SLD_SIGN_OUT OR SLD_CH_4.SIGN;
HORN_OUT            := HORN_OUT OR SLD_CH_4.HORN;
NORMAL_SLD_LAMP_OUT := NORMAL_SLD_LAMP_OUT OR SLD_CH_4.LAMP;
NORMAL_SLD_SIGN_OUT := NORMAL_SLD_SIGN_OUT OR SLD_CH_4.SIGN;
SLD_CH_4_ACTIVE := SLD_CH_4.FILTER_FAILURE_OUT;
IF SLD_CH_4_ACTIVE THEN SLD_TIME_TEMP[3] := SLD_CH_4.TIME_COUNT; END_IF

(*SLD_CH_5: AMS排气阀空气弹簧压力低降速*)
SLD_CH_5(FAILURE := AMS_AIR_SPRING_PRESS_LOW_SLD_P AND (NOT AMS_AIR_SPRING_PRESS_LOW_SLD_PASS_FAIL),
				T_FILTER := Slowdown_from_AMS_SHD_time_filter,
				T_DELAY  := Slowdown_from_AMS_SHD_time_delay,
				OVERRIDE := SLD_OVERRIDE);
AMS_AIR_SPRING_PRESS_LOW := SLD_CH_5.LED;
SLD_LAMP_OUT        := SLD_LAMP_OUT OR SLD_CH_5.LAMP;
SLD_SIGN_OUT        := SLD_SIGN_OUT OR SLD_CH_5.SIGN;
HORN_OUT            := HORN_OUT OR SLD_CH_5.HORN;
NORMAL_SLD_LAMP_OUT := NORMAL_SLD_LAMP_OUT OR SLD_CH_5.LAMP;
NORMAL_SLD_SIGN_OUT := NORMAL_SLD_SIGN_OUT OR SLD_CH_5.SIGN;
SLD_CH_5_ACTIVE := SLD_CH_5.FILTER_FAILURE_OUT;
IF SLD_CH_5_ACTIVE THEN SLD_TIME_TEMP[4] := SLD_CH_5.TIME_COUNT; END_IF

(*SLD_CH_6: AMS增压器转速高降速*)
SLD_CH_6(FAILURE := AMS_TURBOCHG_SPEED_HIGH_SLD_P AND (NOT AMS_TURBOCHG_SPEED_HIGH_SLD_PASS_FAIL),
				T_FILTER := Slowdown_from_AMS_SHD_time_filter,
				T_DELAY  := Slowdown_from_AMS_SHD_time_delay,
				OVERRIDE := SLD_OVERRIDE);
AMS_TURBOCHG_SPEED_HIGH := SLD_CH_6.LED;
SLD_LAMP_OUT        := SLD_LAMP_OUT OR SLD_CH_6.LAMP;
SLD_SIGN_OUT        := SLD_SIGN_OUT OR SLD_CH_6.SIGN;
HORN_OUT            := HORN_OUT OR SLD_CH_6.HORN;
NORMAL_SLD_LAMP_OUT := NORMAL_SLD_LAMP_OUT OR SLD_CH_6.LAMP;
NORMAL_SLD_SIGN_OUT := NORMAL_SLD_SIGN_OUT OR SLD_CH_6.SIGN;
SLD_CH_6_ACTIVE := SLD_CH_6.FILTER_FAILURE_OUT;
IF SLD_CH_6_ACTIVE THEN SLD_TIME_TEMP[5] := SLD_CH_6.TIME_COUNT; END_IF

(*SLD_CH_7: AMS缸套冷却水出口温度高降速*)
SLD_CH_7(FAILURE := AMS_CYL_COOL_WATER_TEMP_HIGH_SLD_P AND (NOT AMS_CYL_COOL_WATER_TEMP_HIGH_SLD_PASS_FAIL),
				T_FILTER := Slowdown_from_AMS_SHD_time_filter,
				T_DELAY  := Slowdown_from_AMS_SHD_time_delay,
				OVERRIDE := SLD_OVERRIDE);
AMS_CYL_COOL_WATER_TEMP_HIGH := SLD_CH_7.LED;
SLD_LAMP_OUT        := SLD_LAMP_OUT OR SLD_CH_7.LAMP;
SLD_SIGN_OUT        := SLD_SIGN_OUT OR SLD_CH_7.SIGN;
HORN_OUT            := HORN_OUT OR SLD_CH_7.HORN;
NORMAL_SLD_LAMP_OUT := NORMAL_SLD_LAMP_OUT OR SLD_CH_7.LAMP;
NORMAL_SLD_SIGN_OUT := NORMAL_SLD_SIGN_OUT OR SLD_CH_7.SIGN;
SLD_CH_7_ACTIVE := SLD_CH_7.FILTER_FAILURE_OUT;
IF SLD_CH_7_ACTIVE THEN SLD_TIME_TEMP[6] := SLD_CH_7.TIME_COUNT; END_IF

(*SLD_CH_8: AMS缸活塞冷却油出口温度高降速*)
SLD_CH_8(FAILURE := AMS_PISTON_COOL_OIL_TEMP_HIGH_SLD_P AND (NOT AMS_PISTON_COOL_OIL_TEMP_HIGH_SLD_PASS_FAIL),
				T_FILTER := Slowdown_from_AMS_SHD_time_filter,
				T_DELAY  := Slowdown_from_AMS_SHD_time_delay,
				OVERRIDE := SLD_OVERRIDE);
AMS_PISTON_COOL_OIL_TEMP_HIGH := SLD_CH_8.LED;
SLD_LAMP_OUT        := SLD_LAMP_OUT OR SLD_CH_8.LAMP;
SLD_SIGN_OUT        := SLD_SIGN_OUT OR SLD_CH_8.SIGN;
HORN_OUT            := HORN_OUT OR SLD_CH_8.HORN;
NORMAL_SLD_LAMP_OUT := NORMAL_SLD_LAMP_OUT OR SLD_CH_8.LAMP;
NORMAL_SLD_SIGN_OUT := NORMAL_SLD_SIGN_OUT OR SLD_CH_8.SIGN;
SLD_CH_8_ACTIVE := SLD_CH_8.FILTER_FAILURE_OUT;
IF SLD_CH_8_ACTIVE THEN SLD_TIME_TEMP[7] := SLD_CH_8.TIME_COUNT; END_IF


(*SLD_CH_9: AMS推力轴承滑油出口温度高降速*)
SLD_CH_9(FAILURE := AMS_THRUST_BRG_OIL_TEMP_HIGH_SLD_P AND (NOT AMS_THRUST_BRG_OIL_TEMP_HIGH_SLD_PASS_FAIL),
				T_FILTER := Slowdown_from_AMS_SHD_time_filter,
				T_DELAY  := Slowdown_from_AMS_SHD_time_delay,
				OVERRIDE := SLD_OVERRIDE);
AMS_THRUST_BRG_OIL_TEMP_HIGH := SLD_CH_9.LED;
SLD_LAMP_OUT        := SLD_LAMP_OUT OR SLD_CH_9.LAMP;
SLD_SIGN_OUT        := SLD_SIGN_OUT OR SLD_CH_9.SIGN;
HORN_OUT            := HORN_OUT OR SLD_CH_9.HORN;
NORMAL_SLD_LAMP_OUT := NORMAL_SLD_LAMP_OUT OR SLD_CH_9.LAMP;
NORMAL_SLD_SIGN_OUT := NORMAL_SLD_SIGN_OUT OR SLD_CH_9.SIGN;
SLD_CH_9_ACTIVE := SLD_CH_9.FILTER_FAILURE_OUT;
IF SLD_CH_9_ACTIVE THEN SLD_TIME_TEMP[8] := SLD_CH_9.TIME_COUNT; END_IF

(*SLD_CH_10: AMS增压器滑油出口温度高降速*)
SLD_CH_10(FAILURE := AMS_TURBOCHG_OIL_TEMP_HIGH_SLD_P AND (NOT AMS_TURBOCHG_OIL_TEMP_HIGH_SLD_PASS_FAIL),
				T_FILTER := Slowdown_from_AMS_SHD_time_filter,
				T_DELAY  := Slowdown_from_AMS_SHD_time_delay,
				OVERRIDE := SLD_OVERRIDE);
AMS_TURBOCHG_OIL_TEMP_HIGH := SLD_CH_10.LED;
SLD_LAMP_OUT        := SLD_LAMP_OUT OR SLD_CH_10.LAMP;
SLD_SIGN_OUT        := SLD_SIGN_OUT OR SLD_CH_10.SIGN;
HORN_OUT            := HORN_OUT OR SLD_CH_10.HORN;
NORMAL_SLD_LAMP_OUT := NORMAL_SLD_LAMP_OUT OR SLD_CH_10.LAMP;
NORMAL_SLD_SIGN_OUT := NORMAL_SLD_SIGN_OUT OR SLD_CH_10.SIGN;
SLD_CH_10_ACTIVE := SLD_CH_10.FILTER_FAILURE_OUT;
IF SLD_CH_10_ACTIVE THEN SLD_TIME_TEMP[9] := SLD_CH_10.TIME_COUNT; END_IF

(*SLD_CH_11: AMS缸排气温度高降速*)
SLD_CH_11(FAILURE := AMS_CYL_EXHAUST_TEMP_HIGH_SLD_P AND (NOT AMS_CYL_EXHAUST_TEMP_HIGH_SLD_PASS_FAIL),
				T_FILTER := Slowdown_from_AMS_SHD_time_filter,
				T_DELAY  := Slowdown_from_AMS_SHD_time_delay,
				OVERRIDE := SLD_OVERRIDE);
AMS_CYL_EXHAUST_TEMP_HIGH := SLD_CH_11.LED;
SLD_LAMP_OUT        := SLD_LAMP_OUT OR SLD_CH_11.LAMP;
SLD_SIGN_OUT        := SLD_SIGN_OUT OR SLD_CH_11.SIGN;
HORN_OUT            := HORN_OUT OR SLD_CH_11.HORN;
NORMAL_SLD_LAMP_OUT := NORMAL_SLD_LAMP_OUT OR SLD_CH_11.LAMP;
NORMAL_SLD_SIGN_OUT := NORMAL_SLD_SIGN_OUT OR SLD_CH_11.SIGN;
SLD_CH_11_ACTIVE := SLD_CH_11.FILTER_FAILURE_OUT;
IF SLD_CH_11_ACTIVE THEN SLD_TIME_TEMP[10] := SLD_CH_11.TIME_COUNT; END_IF

(*SLD_CH_12: AMS增压器进口排气温度高降速*)
SLD_CH_12(FAILURE := AMS_TURBOCHG_INLET_EXHAUST_TEMP_HIGH_SLD_P AND (NOT AMS_TURBOCHG_INLET_EXHAUST_TEMP_HIGH_SLD_PASS_FAIL),
				T_FILTER := Slowdown_from_AMS_SHD_time_filter,
				T_DELAY  := Slowdown_from_AMS_SHD_time_delay,
				OVERRIDE := SLD_OVERRIDE);
AMS_TURBOCHG_INLET_EXHAUST_TEMP_HIGH := SLD_CH_12.LED;
SLD_LAMP_OUT        := SLD_LAMP_OUT OR SLD_CH_12.LAMP;
SLD_SIGN_OUT        := SLD_SIGN_OUT OR SLD_CH_12.SIGN;
HORN_OUT            := HORN_OUT OR SLD_CH_12.HORN;
NORMAL_SLD_LAMP_OUT := NORMAL_SLD_LAMP_OUT OR SLD_CH_12.LAMP;
NORMAL_SLD_SIGN_OUT := NORMAL_SLD_SIGN_OUT OR SLD_CH_12.SIGN;
SLD_CH_12_ACTIVE := SLD_CH_12.FILTER_FAILURE_OUT;
IF SLD_CH_12_ACTIVE THEN SLD_TIME_TEMP[11] := SLD_CH_12.TIME_COUNT; END_IF

(*SLD_CH_13: AMS缸扫气箱着火温度高降速*)
SLD_CH_13(FAILURE := AMS_SCAV_BOX_FIRE_TEMP_HIGH_SLD_P AND (NOT AMS_SCAV_BOX_FIRE_TEMP_HIGH_SLD_PASS_FAIL),
				T_FILTER := Slowdown_from_AMS_SHD_time_filter,
				T_DELAY  := Slowdown_from_AMS_SHD_time_delay,
				OVERRIDE := SLD_OVERRIDE);
AMS_SCAV_BOX_FIRE_TEMP_HIGH := SLD_CH_13.LED;
SLD_LAMP_OUT        := SLD_LAMP_OUT OR SLD_CH_13.LAMP;
SLD_SIGN_OUT        := SLD_SIGN_OUT OR SLD_CH_13.SIGN;
HORN_OUT            := HORN_OUT OR SLD_CH_13.HORN;
NORMAL_SLD_LAMP_OUT := NORMAL_SLD_LAMP_OUT OR SLD_CH_13.LAMP;
NORMAL_SLD_SIGN_OUT := NORMAL_SLD_SIGN_OUT OR SLD_CH_13.SIGN;
SLD_CH_13_ACTIVE := SLD_CH_13.FILTER_FAILURE_OUT;
IF SLD_CH_13_ACTIVE THEN SLD_TIME_TEMP[12] := SLD_CH_13.TIME_COUNT; END_IF

(*SLD_CH_14: 注油器断流降速*)
SLD_CH_14(FAILURE := LUBRICATOR_OIL_FLOW_FAIL_SLD_P AND (NOT LUBRICATOR_OIL_FLOW_FAIL_SLD_PASS_FAIL),
				T_FILTER := Lubricator_oil_flow_SLD_time_filter,
				T_DELAY  := Lubricator_oil_flow_SLD_time_delay,
				OVERRIDE := SLD_OVERRIDE);
LUBRICATOR_OIL_FLOW_FAIL := SLD_CH_14.LED;
SLD_LAMP_OUT        := SLD_LAMP_OUT OR SLD_CH_14.LAMP;
SLD_SIGN_OUT        := SLD_SIGN_OUT OR SLD_CH_14.SIGN;
HORN_OUT            := HORN_OUT OR SLD_CH_14.HORN;
NORMAL_SLD_LAMP_OUT := NORMAL_SLD_LAMP_OUT OR SLD_CH_14.LAMP;
NORMAL_SLD_SIGN_OUT := NORMAL_SLD_SIGN_OUT OR SLD_CH_14.SIGN;
SLD_CH_14_ACTIVE := SLD_CH_14.FILTER_FAILURE_OUT;
IF SLD_CH_14_ACTIVE THEN SLD_TIME_TEMP[13] := SLD_CH_14.TIME_COUNT; END_IF

(*SLD_CH_15: 调速器系统异常降速*)
SLD_CH_15(FAILURE := GOVERNOR_SYS_FAULT_SLD_P AND (NOT GOVERNOR_SYS_FAULT_SLD_PASS_FAIL),
				T_FILTER := Governor_sys_fault_SLD_time_filter,
				T_DELAY  := Governor_sys_fault_SLD_time_delay,
				OVERRIDE := SLD_OVERRIDE);
GOVERNOR_SYS_FAULT := SLD_CH_15.LED;
SLD_LAMP_OUT        := SLD_LAMP_OUT OR SLD_CH_15.LAMP;
SLD_SIGN_OUT        := SLD_SIGN_OUT OR SLD_CH_15.SIGN;
HORN_OUT            := HORN_OUT OR SLD_CH_15.HORN;
NORMAL_SLD_LAMP_OUT := NORMAL_SLD_LAMP_OUT OR SLD_CH_15.LAMP;
NORMAL_SLD_SIGN_OUT := NORMAL_SLD_SIGN_OUT OR SLD_CH_15.SIGN;
SLD_CH_15_ACTIVE := SLD_CH_15.FILTER_FAILURE_OUT;
IF SLD_CH_15_ACTIVE THEN SLD_TIME_TEMP[14] := SLD_CH_15.TIME_COUNT; END_IF

(*===========预期信号聚合, 合成 SHD/SLD_EXPTED_TO_UNIC 并写入全局变量===========*)
SHD_EXPTED_TO_UNIC :=
	SHD_CH_1_ACTIVE OR SHD_CH_2_ACTIVE OR SHD_CH_3_ACTIVE OR
	SHD_CH_4_ACTIVE OR SHD_CH_5_ACTIVE OR SHD_CH_6_ACTIVE;

SLD_EXPTED_TO_UNIC :=
	SLD_CH_1_ACTIVE  OR SLD_CH_2_ACTIVE  OR SLD_CH_3_ACTIVE  OR
	SLD_CH_4_ACTIVE  OR SLD_CH_5_ACTIVE  OR SLD_CH_6_ACTIVE  OR
	SLD_CH_7_ACTIVE  OR SLD_CH_8_ACTIVE  OR SLD_CH_9_ACTIVE  OR
	SLD_CH_10_ACTIVE OR SLD_CH_11_ACTIVE OR SLD_CH_12_ACTIVE OR
	SLD_CH_13_ACTIVE OR SLD_CH_14_ACTIVE OR SLD_CH_15_ACTIVE;

(*===========HMI 剩余延时最小值，写入全局 H_SHD/SLD_TIME_COUNT===========*)
IF SHD_EXPTED_TO_UNIC THEN
	TEMP_SHD_MIN := 200000;
	FOR x := 0 TO 5 DO
		IF SHD_TIME_TEMP[x] < TEMP_SHD_MIN THEN
			TEMP_SHD_MIN := SHD_TIME_TEMP[x];
			a := x;
		END_IF
	END_FOR
END_IF
IF NOT SHD_EXPTED_TO_UNIC OR SHD_OVERRIDE THEN
	H_SHD_TIME_COUNT := 0;
ELSE
	H_SHD_TIME_COUNT := SHD_TIME_TEMP[a] / 1000;
END_IF

IF SLD_EXPTED_TO_UNIC THEN
	TEMP_SLD_MIN := 200000;
	FOR y := 0 TO 14 DO
		IF SLD_TIME_TEMP[y] < TEMP_SLD_MIN THEN
			TEMP_SLD_MIN := SLD_TIME_TEMP[y];
			b := y;
		END_IF
	END_FOR
END_IF
IF NOT SLD_EXPTED_TO_UNIC OR SLD_OVERRIDE OR OMD_SLD_OVERRIDE THEN
	H_SLD_TIME_COUNT := 0;
ELSE
	H_SLD_TIME_COUNT := SLD_TIME_TEMP[b] / 1000;
END_IF

END_FUNCTION_BLOCK
